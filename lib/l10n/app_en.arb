  "privacyTitle": "Privacy",
  "privacyIntro": "Learn how Amaterasu manages your data, app permissions and privacy choices.",
  "privacyDataTitle": "Privacy Policy",
  "privacyDataSubtitle": "Learn what data Amaterasu uses and how it is managed.",
  "privacyPermissionsTitle": "Permissions",
  "privacyPermissionsSubtitle": "Information about permissions the app may request.",
