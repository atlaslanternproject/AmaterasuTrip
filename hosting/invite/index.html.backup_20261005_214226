<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#120e0b">
  <title>Amaterasu Trip · Invito</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      background:
        radial-gradient(
          circle at top,
          #5b2118 0,
          #21120e 36%,
          #120e0b 72%
        );
      color: #f4e7d3;
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    main {
      width: min(100%, 480px);
      padding: 30px;
      text-align: center;
      background: rgba(29, 22, 18, .94);
      border: 1px solid rgba(214, 163, 74, .42);
      border-radius: 24px;
      box-shadow: 0 22px 70px rgba(0, 0, 0, .38);
    }

    .sun {
      width: 64px;
      height: 64px;
      display: grid;
      place-items: center;
      margin: 0 auto 20px;
      border: 1px solid #d6a34a;
      border-radius: 50%;
      color: #d6a34a;
      font-size: 30px;
    }

    h1 {
      margin: 0 0 10px;
      font-size: 26px;
    }

    p {
      color: #cdbda8;
      line-height: 1.55;
    }

    a.button {
      display: block;
      margin-top: 22px;
      padding: 15px 18px;
      border-radius: 14px;
      background: linear-gradient(
        90deg,
        #8b2f23,
        #b9432f
      );
      color: #fff5e8;
      text-decoration: none;
      font-weight: 750;
    }

    a.store {
      display: inline-block;
      margin-top: 18px;
      color: #d6a34a;
      text-decoration: none;
    }

    #error {
      display: none;
      margin-top: 16px;
      color: #e9b3a8;
    }
  </style>
</head>

<body>
  <main>
    <div class="sun">☀</div>

    <h1>Amaterasu Trip</h1>

    <p>
      Hai ricevuto un invito a partecipare a un viaggio.
    </p>

    <a
      id="openApp"
      class="button"
      href="#"
    >
      Apri in Amaterasu Trip
    </a>

    <a
      class="store"
      href="https://play.google.com/store/apps/details?id=com.amaterasutrip"
    >
      Apri Google Play
    </a>

    <p id="error">
      Invito non valido.
    </p>
  </main>

  <script>
    const parts =
      window.location.pathname
        .split('/')
        .filter(Boolean);

    const tripId =
      parts.length >= 2 &&
      parts[0] === 'invite'
        ? parts[1]
        : null;

    const token =
      new URLSearchParams(
        window.location.search
      ).get('token');

    const button =
      document.getElementById('openApp');

    const error =
      document.getElementById('error');

    if (!tripId || !token) {
      button.style.display = 'none';
      error.style.display = 'block';
    } else {
      const deepLink =
        'amaterasutrip:///trip-invite/' +
        encodeURIComponent(tripId) +
        '?token=' +
        encodeURIComponent(token);

      button.href = deepLink;
    }
  </script>
</body>
</html>