rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function usernameBelongsToCurrentUser(username) {
      return signedIn()
        && username is string
        && getAfter(
          /databases/$(database)/documents/usernames/$(username)
        ).data.uid == request.auth.uid;
    }

    function profileUsesUsernameAfter(uid, username) {
      return existsAfter(
        /databases/$(database)/documents/viaggiatori/$(uid)
      )
        && 'usernameLower' in getAfter(
          /databases/$(database)/documents/viaggiatori/$(uid)
        ).data
        && getAfter(
          /databases/$(database)/documents/viaggiatori/$(uid)
        ).data.usernameLower == username;
    }

    function isTripMember(tripData) {
      return verifiedUser()
        && (
          tripData.get('ownerUid', '') == request.auth.uid
          || tripData.get('memberUids', []).hasAny([
            request.auth.uid
          ])
        );
    }

    // =========================================================
    // USER PROFILE
    // =========================================================
    match /viaggiatori/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'username',
          'usernameLower',
          'email',
          'createdAt',
          'firstName',
          'lastName',
          'bio',
          'updatedAt',
          'photoUrl',
          'photoPath'
        ])
        && (
          !('email' in request.resource.data)
          || request.resource.data.email == request.auth.token.email
        )
        && (
          !('usernameLower' in request.resource.data)
          || usernameBelongsToCurrentUser(
            request.resource.data.usernameLower
          )
        );

      allow update: if isSelf(uid)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'username',
            'usernameLower',
            'email',
            'firstName',
            'lastName',
            'bio',
            'updatedAt',
            'photoUrl',
            'photoPath'
          ])
        && (
          (
            !('usernameLower' in resource.data)
            && !('usernameLower' in request.resource.data)
          )
          || (
            'usernameLower' in request.resource.data
            && (
              (
                'usernameLower' in resource.data
                && request.resource.data.usernameLower
                  == resource.data.usernameLower
              )
              || (
                usernameBelongsToCurrentUser(
                  request.resource.data.usernameLower
                )
                && (
                  !('usernameLower' in resource.data)
                  || !existsAfter(
                    /databases/$(database)/documents/usernames/$(resource.data.usernameLower)
                  )
                )
              )
            )
          )
        );

      allow delete: if isSelf(uid);


    }

    // =========================================================
    // USERNAME UNIQUE INDEX
    // =========================================================
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && profileUsesUsernameAfter(
          request.auth.uid,
          username
        );

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !profileUsesUsernameAfter(
          request.auth.uid,
          username
        );
    }

    // =========================================================
    // TRIPS
    // =========================================================
    match /trips/{tripId} {
      allow get: if isTripMember(resource.data);

      allow list: if verifiedUser()
        && resource.data.ownerUid == request.auth.uid;

      allow list: if verifiedUser()
        && resource.data.memberUids.hasAny([
          request.auth.uid
        ]);

      allow create: if verifiedUser()
        && request.resource.data.keys().hasAll([
          'name',
          'destination',
          'destinationData',
          'startDate',
          'endDate',
          'currency',
          'ownerUid',
          'memberUids',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'destination',
          'destinationData',
          'startDate',
          'endDate',
          'currency',
          'cloudArchive',
          'ownerUid',
          'memberUids',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.status == 'active'
        && getAfter(
          /databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)
        ).data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)
        ).data.role == 'admin';

      allow update: if verifiedUser()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'destination',
            'destinationData',
            'startDate',
            'endDate',
            'currency',
            'description',
            'coverUrl',
            'coverPath',
            'updatedAt'
          ]);

      allow delete: if false;

      // =========================================================
      // BUCKET LIST - ACTIVITY, VOTES, DELETION REQUESTS
      // =========================================================

      function bucketTrip() {
        return get(
          /databases/$(database)/documents/trips/$(tripId)
        ).data;
      }

      function bucketMember() {
        return isTripMember(bucketTrip());
      }

      function bucketOwner() {
        return verifiedUser()
          && bucketTrip().get('ownerUid', '') == request.auth.uid;
      }

      function validBucketDate(value) {
        return value is string
          && value.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$'
          );
      }

      function validBucketLink(value) {
        return value is string
          && value.size() <= 2048
          && value.matches('^https?://[^ ]+$');
      }

      function validBucketLinks(links) {
        return links is list
          && links.size() <= 20
          && (links.size() <= 0 || validBucketLink(links[0]))
          && (links.size() <= 1 || validBucketLink(links[1]))
          && (links.size() <= 2 || validBucketLink(links[2]))
          && (links.size() <= 3 || validBucketLink(links[3]))
          && (links.size() <= 4 || validBucketLink(links[4]))
          && (links.size() <= 5 || validBucketLink(links[5]))
          && (links.size() <= 6 || validBucketLink(links[6]))
          && (links.size() <= 7 || validBucketLink(links[7]))
          && (links.size() <= 8 || validBucketLink(links[8]))
          && (links.size() <= 9 || validBucketLink(links[9]))
          && (links.size() <= 10 || validBucketLink(links[10]))
          && (links.size() <= 11 || validBucketLink(links[11]))
          && (links.size() <= 12 || validBucketLink(links[12]))
          && (links.size() <= 13 || validBucketLink(links[13]))
          && (links.size() <= 14 || validBucketLink(links[14]))
          && (links.size() <= 15 || validBucketLink(links[15]))
          && (links.size() <= 16 || validBucketLink(links[16]))
          && (links.size() <= 17 || validBucketLink(links[17]))
          && (links.size() <= 18 || validBucketLink(links[18]))
          && (links.size() <= 19 || validBucketLink(links[19]));
      }

      function validBucketActivity(data) {
        return data.keys().hasAll([
          'tripId', 'name', 'city', 'country', 'type',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
          && data.keys().hasOnly([
            'tripId', 'name', 'city', 'country', 'type',
            'createdByUid', 'createdAt', 'updatedAt',
            'durationMinutes', 'notes', 'usefulLinks',
            'customCategory',
            'googlePlaceId', 'address', 'latitude', 'longitude'
          ])
          && data.tripId == tripId
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 200
          && data.city is string
          && data.city.size() <= 150
          && data.country is string
          && data.country.size() <= 150
          && data.type in [
            'attraction', 'area', 'city',
            'experience', 'event', 'other'
          ]
          && (data.get('customCategory', null) == null || (data.customCategory is string && data.customCategory.size() <= 60))
          && data.createdByUid is string
          && data.createdByUid.size() > 0
          && validBucketDate(data.createdAt)
          && validBucketDate(data.updatedAt)
          && data.get('notes', '') is string
          && data.get('notes', '').size() <= 10000
          && validBucketLinks(data.get('usefulLinks', []))
          && (
            data.get('durationMinutes', null) == null
            || (
              data.durationMinutes is int
              && data.durationMinutes > 0
              && data.durationMinutes <= 10080
            )
          )
          && (
            data.get('googlePlaceId', null) == null
            || data.googlePlaceId is string
          )
          && (
            data.get('address', null) == null
            || data.address is string
          )
          && (
            data.get('latitude', null) == null
            || (
              data.latitude is number
              && data.latitude >= -90
              && data.latitude <= 90
            )
          )
          && (
            data.get('longitude', null) == null
            || (
              data.longitude is number
              && data.longitude >= -180
              && data.longitude <= 180
            )
          );
      }

      match /bucketCategories/{categoryId} {
        allow get, list: if bucketMember();
        allow create: if bucketMember()
          && categoryId.matches('^[a-z0-9-]{1,80}$')
          && request.resource.data.keys().hasOnly(['label','createdByUid','createdAt'])
          && request.resource.data.keys().hasAll(['label','createdByUid','createdAt'])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 60
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /bucketList/{activityId} {
        allow get, list: if bucketMember();

        allow create: if bucketMember()
          && validBucketActivity(request.resource.data)
          && request.resource.data.createdByUid == request.auth.uid;

        allow update: if bucketMember()
          && validBucketActivity(request.resource.data)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'name', 'city', 'country', 'type',
              'durationMinutes', 'notes', 'usefulLinks',
              'customCategory',
              'googlePlaceId', 'address', 'latitude',
              'longitude', 'updatedAt'
            ])
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.createdByUid
            == resource.data.createdByUid
          && request.resource.data.createdAt
            == resource.data.createdAt;

        // Physical deletion is reserved for a separate server flow.
        allow delete: if false;

        match /votes/{voteUid} {
          allow get, list: if bucketMember();

          allow create, update: if bucketMember()
            && voteUid == request.auth.uid
            && exists(
              /databases/$(database)/documents/trips/$(tripId)/bucketList/$(activityId)
            )
            && request.resource.data.keys().hasOnly([
              'priority', 'updatedAt'
            ])
            && request.resource.data.keys().hasAll([
              'priority', 'updatedAt'
            ])
            && request.resource.data.priority in [
              'SS', 'S', 'A', 'B'
            ]
            && request.resource.data.updatedAt == request.time;

          allow delete: if false;
        }

        match /deletionRequests/{requestUid} {
          allow get, list: if bucketMember();

          allow create: if bucketMember()
            && requestUid == request.auth.uid
            && requestUid != bucketTrip().ownerUid
            && exists(
              /databases/$(database)/documents/trips/$(tripId)/bucketList/$(activityId)
            )
            && request.resource.data.keys().hasOnly([
              'activityId', 'requestedByUid', 'reason',
              'status', 'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'activityId', 'requestedByUid', 'reason',
              'status', 'createdAt'
            ])
            && request.resource.data.activityId == activityId
            && request.resource.data.requestedByUid == requestUid
            && request.resource.data.reason is string
            && request.resource.data.reason.size() <= 500
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time;

          allow update: if bucketOwner()
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'status', 'reviewedByUid', 'reviewedAt'
              ])
            && request.resource.data.keys().hasAll([
              'status', 'reviewedByUid', 'reviewedAt'
            ])
            && request.resource.data.status in [
              'approved', 'rejected'
            ]
            && request.resource.data.reviewedByUid
              == request.auth.uid
            && request.resource.data.reviewedAt == request.time;

          allow delete: if false;
        }
      }

      // =========================================================
      // BUDGET SECURITY B2.2
      //
      // Read-only for Firebase clients.
      // Financial writes require trusted server operations.
      // =========================================================

      function budgetActiveMember() {
        return verifiedUser()
          && exists(
            /databases/$(database)/documents/trips/$(tripId)
          )
          && isTripMember(
            get(
              /databases/$(database)/documents/trips/$(tripId)
            ).data
          );
      }

      function budgetPrivateOwner(ownerUid) {
        return budgetActiveMember()
          && request.auth.uid == ownerUid;
      }

      function budgetExpenseParticipant(expenseId) {
        return budgetActiveMember()
          && exists(
            /databases/$(database)/documents/trips/$(tripId)/budgetSharedExpenses/$(expenseId)
          )
          && get(
            /databases/$(database)/documents/trips/$(tripId)/budgetSharedExpenses/$(expenseId)
          ).data.get('participantUids', []).hasAny([request.auth.uid]);
      }

      match /budgetSharedExpenses/{expenseId} {
        allow get, list: if budgetActiveMember()
          && resource.data.get('participantUids', []).hasAny([request.auth.uid]);
        allow create, update, delete: if false;

        match /{budgetChild=**} {
          allow get, list: if budgetExpenseParticipant(expenseId);
          allow create, update, delete: if false;
        }
      }

      match /budgetCategories/{categoryId} {
        allow get, list: if budgetActiveMember();
        allow create, update, delete: if false;
      }

      match /budgetPrivateOwners/{ownerUid} {
        allow get, list: if budgetPrivateOwner(ownerUid);
        allow create, update, delete: if false;

        // B7.1: optional personal travel budget, never shared.
        match /settings/{settingId} {
          allow get: if settingId == 'personalBudget'
            && budgetPrivateOwner(ownerUid);
          allow list: if false;

          allow create, update: if settingId == 'personalBudget'
            && budgetPrivateOwner(ownerUid)
            && request.resource.data.keys().hasOnly([
              'amountMinor', 'currency', 'updatedAt'
            ])
            && request.resource.data.keys().hasAll([
              'amountMinor', 'currency', 'updatedAt'
            ])
            && request.resource.data.amountMinor is int
            && request.resource.data.amountMinor > 0
            && request.resource.data.amountMinor <= 9000000000000
            && request.resource.data.currency is string
            && request.resource.data.currency.matches('^[A-Z]{3}$')
            && request.resource.data.updatedAt == request.time;

          allow delete: if settingId == 'personalBudget'
            && budgetPrivateOwner(ownerUid);
        }

        match /{privateChild=**} {
          allow get, list: if budgetPrivateOwner(ownerUid);
          allow create, update, delete: if false;
        }
      }

      // =========================================================
      // HOTEL / ALLOGGI (stays)
      // Members read, create and edit; the creator or the owner
      // deletes. Links follow exactly the Bucket List rules.
      // =========================================================
      function stayTrip() {
        return get(
          /databases/$(database)/documents/trips/$(tripId)
        ).data;
      }

      function stayMember() {
        return isTripMember(stayTrip());
      }

      function validStayDay(value) {
        return value is string
          && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      function validStayTime(data, key) {
        return data.get(key, null) == null
          || (data[key] is string
            && data[key].matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
      }

      function validStayText(data, key, maxSize) {
        return data.get(key, null) == null
          || (data[key] is string && data[key].size() <= maxSize);
      }

      function validStayLink(data, key) {
        return data.get(key, null) == null || validBucketLink(data[key]);
      }

      function validStay(data) {
        return data.keys().hasAll([
          'tripId', 'name', 'checkInDate', 'checkOutDate', 'status',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
          && data.keys().hasOnly([
            'tripId', 'name', 'checkInDate', 'checkOutDate', 'status',
            'createdByUid', 'createdAt', 'updatedAt',
            'checkInTime', 'checkOutTime',
            'address', 'city', 'country', 'googlePlaceId',
            'latitude', 'longitude',
            'bookedVia', 'bookedViaOther', 'bookingUrl', 'propertyUrl',
            'confirmationCode', 'notes', 'guestUids', 'expenseId',
            'type', 'phone', 'email',
            'estimatedCostMinorUnits', 'estimatedCostCurrency',
            'freeCancellationUntil', 'amenities', 'directions', 'extras'
          ])
          && data.tripId == tripId
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 200
          && validStayDay(data.checkInDate)
          && validStayDay(data.checkOutDate)
          && data.checkOutDate >= data.checkInDate
          && data.status in ['booked', 'toConfirm', 'cancelled']
          && data.createdByUid is string
          && data.createdByUid.size() > 0
          && data.updatedAt == request.time
          && validStayTime(data, 'checkInTime')
          && validStayTime(data, 'checkOutTime')
          && validStayText(data, 'address', 300)
          && validStayText(data, 'city', 150)
          && validStayText(data, 'country', 150)
          && validStayText(data, 'googlePlaceId', 300)
          && validStayText(data, 'confirmationCode', 100)
          && validStayText(data, 'notes', 10000)
          && (
            data.get('latitude', null) == null
            || (data.latitude is number
              && data.latitude >= -90 && data.latitude <= 90)
          )
          && (
            data.get('longitude', null) == null
            || (data.longitude is number
              && data.longitude >= -180 && data.longitude <= 180)
          )
          && (
            data.get('bookedVia', null) == null
            || data.bookedVia in [
              'booking', 'airbnb', 'propertySite', 'agency', 'other'
            ]
          )
          && (
            data.get('bookedViaOther', null) == null
            || (data.get('bookedVia', null) == 'other'
              && data.bookedViaOther is string
              && data.bookedViaOther.size() > 0
              && data.bookedViaOther.size() <= 60)
          )
          && validStayLink(data, 'bookingUrl')
          && validStayLink(data, 'propertyUrl')
          && (
            data.get('guestUids', null) == null
            || (data.guestUids is list && data.guestUids.size() <= 50)
          )
          && (
            data.get('expenseId', null) == null
            || (data.expenseId is string
              && data.expenseId.matches('^[A-Za-z0-9_-]{1,128}$'))
          )
          // Optional type of stay and contacts (v1.12.0).
          && (
            data.get('type', null) == null
            || data.type in [
              'hotel', 'bnb', 'apartment', 'hostel', 'camping', 'other'
            ]
          )
          && (
            data.get('phone', null) == null
            || (data.phone is string
              && data.phone.size() <= 40
              && data.phone.matches('^[+]?[0-9 ()./-]{4,40}$'))
          )
          && (
            data.get('email', null) == null
            || (data.email is string
              && data.email.size() <= 254
              && data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$'))
          )
          // Optional cost, free cancellation, services, directions (v1.15.0).
          && (
            (data.get('estimatedCostMinorUnits', null) == null
              && data.get('estimatedCostCurrency', null) == null)
            || (data.get('estimatedCostMinorUnits', null) is int
              && data.estimatedCostMinorUnits > 0
              && data.estimatedCostMinorUnits <= 1000000000000
              && data.get('estimatedCostCurrency', null) is string
              && data.estimatedCostCurrency.matches('^[A-Z]{3}$'))
          )
          && (
            data.get('freeCancellationUntil', null) == null
            || validStayDay(data.freeCancellationUntil)
          )
          && (
            data.get('amenities', null) == null
            || (data.amenities is list
              && data.amenities.size() <= 4
              && data.amenities.hasOnly([
                'breakfast', 'parking', 'wifi', 'kitchen'
              ]))
          )
          && validStayText(data, 'directions', 2000)
          // Access, late arrival and city tax, grouped (v1.31.0).
          && (!('extras' in data) || validStayExtras(data.extras));
      }

      // One cheap check per field: matches() also requires a string.
      function validStayExtras(e) {
        return e is map
          && e.keys().hasOnly([
            'doorCode', 'wifiName', 'wifiPassword', 'accessNotes',
            'lateArrivalTime', 'receptionContact',
            'taxMinorUnits', 'taxCurrency', 'taxPersons'
          ])
          && e.get('doorCode', '').matches('^.{0,100}$')
          && e.get('wifiName', '').matches('^.{0,100}$')
          && e.get('wifiPassword', '').matches('^.{0,100}$')
          && e.get('accessNotes', '').matches('(?s)^.{0,1000}$')
          && e.get('receptionContact', '').matches('^.{0,200}$')
          && e.get('lateArrivalTime', '00:00')
            .matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && e.get('taxCurrency', 'EUR').matches('^[A-Z]{3}$')
          && (('taxMinorUnits' in e) == ('taxCurrency' in e))
          && (!('taxMinorUnits' in e)
            || (e.taxMinorUnits is int
              && e.taxMinorUnits > 0 && e.taxMinorUnits <= 100000000))
          && (!('taxPersons' in e)
            || (e.taxPersons is int && e.taxPersons >= 1 && e.taxPersons <= 50));
      }

      match /stays/{stayId} {
        allow get, list: if stayMember();

        allow create: if stayMember()
          && validStay(request.resource.data)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update: if stayMember()
          && validStay(request.resource.data)
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.createdByUid
            == resource.data.createdByUid
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if stayMember()
          && (
            resource.data.createdByUid == request.auth.uid
            || stayTrip().get('ownerUid', '') == request.auth.uid
          );
      }

      // =====================================================
      // SEZIONI DEL VIAGGIO (v1.16.0+): funzioni comuni ai nuovi
      // blocchi (trasporti, prenotazioni, ristoranti, ...).
      // Membri: leggono, creano e modificano; eliminano solo il
      // creatore o il proprietario del viaggio.
      // =====================================================
      function sectionTrip() {
        return get(
          /databases/$(database)/documents/trips/$(tripId)
        ).data;
      }

      function sectionMember() {
        return isTripMember(sectionTrip());
      }

      function sectionBase(data, required, allowed) {
        return data.keys().hasAll(
          ['tripId', 'createdByUid', 'createdAt', 'updatedAt'].concat(required)
        )
          && data.keys().hasOnly(
            ['tripId', 'createdByUid', 'createdAt', 'updatedAt',
              'expenseId', 'estimatedCostMinorUnits',
              'estimatedCostCurrency'].concat(allowed)
          )
          && data.tripId == tripId
          && data.createdByUid is string
          && data.createdByUid.size() > 0
          && data.updatedAt == request.time
          && (
            data.get('expenseId', null) == null
            || (data.expenseId is string
              && data.expenseId.matches('^[A-Za-z0-9_-]{1,128}$'))
          )
          && (
            (data.get('estimatedCostMinorUnits', null) == null
              && data.get('estimatedCostCurrency', null) == null)
            || (data.get('estimatedCostMinorUnits', null) is int
              && data.estimatedCostMinorUnits > 0
              && data.estimatedCostMinorUnits <= 1000000000000
              && data.get('estimatedCostCurrency', null) is string
              && data.estimatedCostCurrency.matches('^[A-Z]{3}$'))
          );
      }

      function sectionText(data, key, maxSize) {
        return !(key in data)
          || (data[key] is string && data[key].size() <= maxSize);
      }

      function sectionName(data, key, maxSize) {
        return data[key] is string
          && data[key].size() > 0
          && data[key].size() <= maxSize;
      }

      // One matches() per field (v1.34.0): it also requires a string; a
      // missing field takes a valid default. Same meaning, fewer operations.
      function sectionDay(data, key) {
        return data.get(key, '2000-01-01').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      function sectionTime(data, key) {
        return data.get(key, '00:00').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }

      function sectionLink(data, key) {
        return !(key in data) || validBucketLink(data[key]);
      }

      // Useful links (v1.34.0): up to 10 web addresses (2048 characters
      // each in the app), checked together with one pattern to stay far
      // from the 1000-operation limit.
      function sectionLinks(data) {
        return !('usefulLinks' in data)
          || (data.usefulLinks is list
            && data.usefulLinks.size() <= 10
            && data.usefulLinks.join(' ').size() <= 20489
            && data.usefulLinks.join(' ').matches(
              '^https?://[^ ]+( https?://[^ ]+){0,9}$'));
      }

      function sectionUids(data, key) {
        return !(key in data)
          || (data[key] is list && data[key].size() <= 50);
      }

      function sectionIn(data, key, values) {
        return !(key in data) || data[key] in values;
      }

      function sectionNumber(data, key, low, high) {
        return !(key in data)
          || (data[key] is number && data[key] >= low && data[key] <= high);
      }

      function sectionInt(data, key, high) {
        return !(key in data)
          || (data[key] is int && data[key] >= 0 && data[key] <= high);
      }

      function sectionPlace(data, prefix) {
        let lat = data.get(prefix + 'Latitude', 0);
        let lng = data.get(prefix + 'Longitude', 0);
        return data.get(prefix + 'Name', '').matches('(?s)^.{0,200}$')
          && data.get(prefix + 'Address', '').matches('(?s)^.{0,300}$')
          && data.get(prefix + 'PlaceId', '').matches('(?s)^.{0,300}$')
          && lat is number && lat >= -90 && lat <= 90
          && lng is number && lng >= -180 && lng <= 180;
      }

      function sectionCreateOk(data) {
        return sectionMember()
          && data.createdByUid == request.auth.uid
          && data.createdAt == request.time;
      }

      function sectionUpdateOk(data) {
        return sectionMember()
          && data.tripId == resource.data.tripId
          && data.createdByUid == resource.data.createdByUid
          && data.createdAt == resource.data.createdAt;
      }

      function sectionDeleteOk() {
        return sectionMember()
          && (
            resource.data.createdByUid == request.auth.uid
            || sectionTrip().get('ownerUid', '') == request.auth.uid
          );
      }

      // TRASPORTI (transports, v1.16.0)
      function validTransport(data) {
        return sectionBase(data, ['type', 'status', 'departureDate'], [
          'type', 'status',
          'fromName', 'fromAddress', 'fromPlaceId',
          'fromLatitude', 'fromLongitude',
          'toName', 'toAddress', 'toPlaceId',
          'toLatitude', 'toLongitude',
          'departureDate', 'departureTime', 'departureOffset',
          'arrivalDate', 'arrivalTime', 'arrivalOffset',
          'carrier', 'number', 'bookingCode', 'seats',
          'passengerUids', 'bookedVia', 'bookingUrl', 'notes', 'extras',
          'usefulLinks'
        ])
          && sectionLinks(data)
          && data.type in [
            'flight', 'train', 'bus', 'ferry', 'carRental', 'transfer',
            'other'
          ]
          && data.status in ['toBook', 'booked', 'cancelled']
          && sectionPlace(data, 'from')
          && sectionPlace(data, 'to')
          && sectionDay(data, 'departureDate')
          && sectionDay(data, 'arrivalDate')
          && (
            data.get('arrivalDate', null) == null
            || data.arrivalDate >= data.departureDate
          )
          && sectionTime(data, 'departureTime')
          && sectionTime(data, 'arrivalTime')
          && sectionOffset(data, 'departureOffset')
          && sectionOffset(data, 'arrivalOffset')
          && data.get('carrier', '').matches('(?s)^.{0,120}$')
          && data.get('number', '').matches('(?s)^.{0,120}$')
          && data.get('bookingCode', '').matches('(?s)^.{0,100}$')
          && data.get('seats', '').matches('(?s)^.{0,120}$')
          && data.get('bookedVia', '').matches('(?s)^.{0,120}$')
          && data.get('notes', '') is string
          && data.get('notes', '').size() <= 10000
          && sectionUids(data, 'passengerUids')
          && sectionLink(data, 'bookingUrl')
          // Seats, check-in, airport time, car rental (v1.27.0).
          && (!('extras' in data) || validTransportExtras(data.extras));
      }

      function validTransportExtras(extras) {
        return extras is map
          && extras.keys().hasOnly([
            'seatsByPassenger', 'checkInHoursBefore', 'checkInUrl',
            'airportMinutesBefore', 'fuelPolicy', 'deductible'
          ])
          && (!('seatsByPassenger' in extras)
            || (extras.seatsByPassenger is map
              && extras.seatsByPassenger.size() <= 50))
          && sectionInt(extras, 'checkInHoursBefore', 168)
          && sectionLink(extras, 'checkInUrl')
          && sectionInt(extras, 'airportMinutesBefore', 600)
          && sectionText(extras, 'fuelPolicy', 60)
          && sectionText(extras, 'deductible', 60);
      }

      function sectionOffset(data, key) {
        return data.get(key, '+00:00').matches('^[+-](0[0-9]|1[0-4]):(00|30|45)$');
      }

      match /transports/{itemId} {
        allow get, list: if sectionMember();
        allow create: if sectionCreateOk(request.resource.data)
          && validTransport(request.resource.data);
        allow update: if sectionUpdateOk(request.resource.data)
          && validTransport(request.resource.data);
        allow delete: if sectionDeleteOk();
      }

      // PRENOTAZIONI (reservations, v1.17.0)
      function validReservation(data) {
        return sectionBase(data, ['name', 'category', 'status'], [
          'name', 'category', 'status', 'date', 'time',
          'placeName', 'placeAddress', 'placePlaceId',
          'placeLatitude', 'placeLongitude',
          'bookingCode', 'bookingUrl', 'participantUids',
          'cancellationPolicy', 'notes',
          'bookBy', 'holder', 'ticketCount', 'ticketCode',
          'usefulLinks'
        ])
          && sectionLinks(data)
          && sectionName(data, 'name', 200)
          && data.category in ['ticket', 'entry', 'tour', 'excursion', 'other']
          && data.status in ['toBook', 'booked', 'cancelled']
          && sectionDay(data, 'date')
          && sectionTime(data, 'time')
          && sectionPlace(data, 'place')
          && sectionText(data, 'bookingCode', 100)
          && sectionLink(data, 'bookingUrl')
          && sectionUids(data, 'participantUids')
          && sectionText(data, 'cancellationPolicy', 2000)
          // Book-by day, holder, tickets and QR code text (v1.28.0).
          && sectionDay(data, 'bookBy')
          && sectionText(data, 'holder', 120)
          && (!('ticketCount' in data)
            || (data.ticketCount is int
              && data.ticketCount >= 1 && data.ticketCount <= 99))
          && sectionText(data, 'ticketCode', 500)
          && sectionText(data, 'notes', 10000);
      }

      match /reservations/{itemId} {
        allow get, list: if sectionMember();
        allow create: if sectionCreateOk(request.resource.data)
          && validReservation(request.resource.data);
        allow update: if sectionUpdateOk(request.resource.data)
          && validReservation(request.resource.data);
        allow delete: if sectionDeleteOk();
      }

      // RISTORANTI (restaurants, v1.18.0). I voti stanno nel campo votes
      // (uid -> SS/S/A/B): ognuno crea o cambia solo il proprio voto.
      function validRestaurant(data) {
        return sectionBase(data, ['name', 'status'], [
          'name', 'status',
          'placeName', 'placeAddress', 'placePlaceId',
          'placeLatitude', 'placeLongitude',
          'phone', 'website', 'cuisine', 'priceLevel',
          'reservationDate', 'reservationTime', 'partySize',
          'notes', 'votes', 'allergens', 'allergenNotes', 'diets',
          'triedRating', 'triedNote',
          'usefulLinks'
        ])
          && sectionLinks(data)
          && sectionName(data, 'name', 200)
          && data.status in ['toTry', 'booked', 'tried']
          // Stars and note once tried (v1.29.0).
          && (!('triedRating' in data)
            || (data.triedRating is int
              && data.triedRating >= 1 && data.triedRating <= 5))
          && sectionText(data, 'triedNote', 1000)
          // EU allergens to tell the restaurant and diet labels (v1.25.0).
          && (
            data.get('allergens', null) == null
            || (data.allergens is list
              && data.allergens.size() <= 14
              && data.allergens.hasOnly([
                'gluten', 'crustaceans', 'eggs', 'fish', 'peanuts', 'soy',
                'milk', 'nuts', 'celery', 'mustard', 'sesame', 'sulphites',
                'lupin', 'molluscs'
              ]))
          )
          && sectionText(data, 'allergenNotes', 500)
          && (
            data.get('diets', null) == null
            || (data.diets is list
              && data.diets.size() <= 5
              && data.diets.hasOnly([
                'vegetarian', 'vegan', 'halal', 'kosher', 'glutenFree'
              ]))
          )
          && sectionPlace(data, 'place')
          && (
            data.get('phone', null) == null
            || (data.phone is string
              && data.phone.size() <= 40
              && data.phone.matches('^[+]?[0-9 ()./-]{4,40}$'))
          )
          && sectionLink(data, 'website')
          && sectionText(data, 'cuisine', 120)
          && (
            data.get('priceLevel', null) == null
            || (data.priceLevel is int
              && data.priceLevel >= 1 && data.priceLevel <= 4)
          )
          && sectionDay(data, 'reservationDate')
          && sectionTime(data, 'reservationTime')
          && (
            data.get('partySize', null) == null
            || (data.partySize is int
              && data.partySize >= 1 && data.partySize <= 100)
          )
          && sectionText(data, 'notes', 10000)
          && (
            data.get('votes', null) == null
            || (data.votes is map
              && data.votes.size() <= 50
              && data.votes.values().hasOnly(['SS', 'S', 'A', 'B']))
          );
      }

      match /restaurants/{itemId} {
        allow get, list: if sectionMember();
        allow create: if sectionCreateOk(request.resource.data)
          && validRestaurant(request.resource.data)
          && request.resource.data.get('votes', {}).keys()
            .hasOnly([request.auth.uid]);
        allow update: if sectionUpdateOk(request.resource.data)
          && validRestaurant(request.resource.data)
          && request.resource.data.get('votes', {})
            .diff(resource.data.get('votes', {}))
            .affectedKeys().hasOnly([request.auth.uid]);
        allow delete: if sectionDeleteOk();
      }

      // LUOGHI SALVATI (savedPlaces, v1.19.0)
      function validSavedPlace(data) {
        return sectionBase(data, ['name', 'category'], [
          'name', 'category',
          'placeName', 'placeAddress', 'placePlaceId',
          'placeLatitude', 'placeLongitude',
          'mapsUrl', 'notes', 'phone', 'website',
          'priority', 'visited', 'visitMinutes', 'ticketsUrl', 'area',
          'plannedDay',
          'usefulLinks'
        ])
          && sectionLinks(data)
          && sectionName(data, 'name', 200)
          && data.category in [
            'sight', 'food', 'shopping', 'nature', 'nightlife', 'other'
          ]
          // Priority, visited, visit time, tickets, area, day (v1.30.0).
          && (!('priority' in data) || data.priority in ['SS', 'S', 'A', 'B'])
          && (!('visited' in data) || data.visited is bool)
          && (!('visitMinutes' in data)
            || (data.visitMinutes is int
              && data.visitMinutes >= 1 && data.visitMinutes <= 1440))
          && sectionLink(data, 'ticketsUrl')
          && sectionText(data, 'area', 120)
          && sectionDay(data, 'plannedDay')
          // Contacts of the place (v1.25.0).
          && (
            data.get('phone', null) == null
            || (data.phone is string
              && data.phone.size() <= 40
              && data.phone.matches('^[+]?[0-9 ()./-]{4,40}$'))
          )
          && sectionLink(data, 'website')
          && sectionPlace(data, 'place')
          && sectionLink(data, 'mapsUrl')
          && sectionText(data, 'notes', 10000);
      }

      match /savedPlaces/{itemId} {
        allow get, list: if sectionMember();
        allow create: if sectionCreateOk(request.resource.data)
          && validSavedPlace(request.resource.data);
        allow update: if sectionUpdateOk(request.resource.data)
          && validSavedPlace(request.resource.data);
        allow delete: if sectionDeleteOk();
      }

      // NOTE (notes, v1.20.0). Le note private (visibility 'private') le
      // leggono, modificano ed eliminano solo i loro autori.
      function validNote(data) {
        return sectionBase(data, ['title', 'visibility'], [
          'title', 'visibility', 'body', 'pinned', 'checklist',
          'linkSection', 'linkId', 'linkName',
          'usefulLinks'
        ])
          && sectionLinks(data)
          && sectionName(data, 'title', 200)
          // Element of another section the note talks about (v1.32.0).
          && (!('linkSection' in data)
            || (data.linkSection in [
                'stays', 'transports', 'reservations', 'restaurants',
                'savedPlaces'
              ]
              && data.linkId is string
              && data.linkId.matches('^[A-Za-z0-9_-]{1,128}$')
              && sectionName(data, 'linkName', 200)))
          && data.visibility in ['shared', 'private']
          && sectionText(data, 'body', 10000)
          && (data.get('pinned', null) == null || data.pinned is bool)
          && (
            data.get('checklist', null) == null
            || (data.checklist is list && data.checklist.size() <= 100)
          );
      }

      function noteReadable() {
        return sectionMember()
          && (
            resource.data.visibility == 'shared'
            || resource.data.createdByUid == request.auth.uid
          );
      }

      match /notes/{itemId} {
        allow get, list: if noteReadable();
        allow create: if sectionCreateOk(request.resource.data)
          && validNote(request.resource.data);
        allow update: if sectionUpdateOk(request.resource.data)
          && validNote(request.resource.data)
          && (
            resource.data.createdByUid == request.auth.uid
            || (resource.data.visibility == 'shared'
              && request.resource.data.visibility == 'shared')
          );
        allow delete: if sectionDeleteOk() && noteReadable();
      }

      // SHOPPING E VALIGIA (shoppingItems, packingItems, v1.21.0)
      function validShoppingItem(data) {
        return sectionBase(data, ['name', 'bought'], [
          'name', 'bought', 'forUid', 'where',
          'actualCostMinorUnits', 'actualCostCurrency', 'notes',
          'forText', 'priority', 'boughtByUid',
          'usefulLinks'
        ])
          && sectionLinks(data)
          && sectionName(data, 'name', 200)
          && data.bought is bool
          && sectionText(data, 'forUid', 128)
          // Free recipient, priority and who bought it (v1.33.0).
          && sectionText(data, 'forText', 120)
          && (!('priority' in data) || data.priority in ['SS', 'S', 'A', 'B'])
          && sectionText(data, 'boughtByUid', 128)
          && sectionText(data, 'where', 200)
          && sectionText(data, 'notes', 10000)
          && (
            (data.get('actualCostMinorUnits', null) == null
              && data.get('actualCostCurrency', null) == null)
            || (data.get('actualCostMinorUnits', null) is int
              && data.actualCostMinorUnits > 0
              && data.actualCostMinorUnits <= 1000000000000
              && data.get('actualCostCurrency', null) is string
              && data.actualCostCurrency.matches('^[A-Z]{3}$'))
          );
      }

      function validPackingItem(data) {
        return sectionBase(data, ['name', 'packed'], [
          'name', 'packed', 'personUid', 'quantity'
        ])
          && sectionName(data, 'name', 200)
          && data.packed is bool
          && sectionText(data, 'personUid', 128)
          && (
            data.get('quantity', null) == null
            || (data.quantity is int
              && data.quantity >= 1 && data.quantity <= 99)
          );
      }

      match /shoppingItems/{itemId} {
        allow get, list: if sectionMember();
        allow create: if sectionCreateOk(request.resource.data)
          && validShoppingItem(request.resource.data);
        allow update: if sectionUpdateOk(request.resource.data)
          && validShoppingItem(request.resource.data);
        allow delete: if sectionDeleteOk();
      }

      match /packingItems/{itemId} {
        allow get, list: if sectionMember();
        allow create: if sectionCreateOk(request.resource.data)
          && validPackingItem(request.resource.data);
        allow update: if sectionUpdateOk(request.resource.data)
          && validPackingItem(request.resource.data);
        allow delete: if sectionDeleteOk();
      }

      // RICORDI (memories, v1.22.0): diario per giorno o link a un album
      // esterno. Nessuna foto su Firebase.
      function validMemory(data) {
        return sectionBase(data, ['kind'], [
          'kind', 'date', 'text', 'rating', 'moment', 'title', 'url',
          'usefulLinks'
        ])
          && sectionLinks(data)
          && data.kind in ['day', 'album']
          && sectionDay(data, 'date')
          && sectionText(data, 'text', 10000)
          && sectionText(data, 'moment', 300)
          && sectionText(data, 'title', 200)
          && sectionLink(data, 'url')
          && (
            data.get('rating', null) == null
            || (data.rating is int && data.rating >= 1 && data.rating <= 5)
          )
          && (
            (data.kind == 'day' && data.get('date', null) != null)
            || (data.kind == 'album'
              && data.get('url', null) != null
              && data.get('title', null) != null)
          );
      }

      match /memories/{itemId} {
        allow get, list: if sectionMember();
        allow create: if sectionCreateOk(request.resource.data)
          && validMemory(request.resource.data);
        allow update: if sectionUpdateOk(request.resource.data)
          && validMemory(request.resource.data);
        allow delete: if sectionDeleteOk();
      }

      // CHECKLIST (checklists, v1.26.0). Le voci stanno nel campo items
      // (al massimo 300); le liste personali (visibility 'private') le
      // leggono, modificano ed eliminano solo i loro autori.
      function validChecklist(data) {
        return sectionBase(data, ['title', 'visibility'], [
          'title', 'visibility', 'template', 'categories', 'items'
        ])
          && sectionName(data, 'title', 200)
          && data.visibility in ['shared', 'private']
          && sectionText(data, 'template', 40)
          && (
            data.get('categories', null) == null
            || (data.categories is list && data.categories.size() <= 30)
          )
          && (
            data.get('items', null) == null
            || (data.items is map && data.items.size() <= 300)
          );
      }

      function checklistReadable() {
        return sectionMember()
          && (
            resource.data.visibility == 'shared'
            || resource.data.createdByUid == request.auth.uid
          );
      }

      match /checklists/{itemId} {
        allow get, list: if checklistReadable();
        allow create: if sectionCreateOk(request.resource.data)
          && validChecklist(request.resource.data);
        allow update: if sectionUpdateOk(request.resource.data)
          && validChecklist(request.resource.data)
          && (
            resource.data.createdByUid == request.auth.uid
            || (resource.data.visibility == 'shared'
              && request.resource.data.visibility == 'shared')
          );
        allow delete: if sectionDeleteOk() && checklistReadable();
      }

      match /members/{memberUid} {
        allow read: if false;

        allow create: if verifiedUser()
          && memberUid == request.auth.uid
          && !exists(
            /databases/$(database)/documents/trips/$(tripId)
          )
          && getAfter(
            /databases/$(database)/documents/trips/$(tripId)
          ).data.ownerUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/trips/$(tripId)
          ).data.memberUids == [request.auth.uid]
          && request.resource.data.keys().hasOnly([
            'uid',
            'role',
            'joinedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'admin';

        allow update, delete: if false;
      }
    }

    // =========================================================
    // INVITATIONS
    // =========================================================
    match /tripInvites/{tripId} {
      allow read, write: if false;
    }

    // =========================================================
    // E2EE legacy: accesso client disabilitato.
    match /e2eeRoots/{uid} {
      allow read, write: if false;
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
