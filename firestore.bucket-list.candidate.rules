rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function usernameBelongsToCurrentUser(username) {
      return signedIn()
        && username is string
        && getAfter(
          /databases/$(database)/documents/usernames/$(username)
        ).data.uid == request.auth.uid;
    }

    function profileUsesUsernameAfter(uid, username) {
      return existsAfter(
        /databases/$(database)/documents/viaggiatori/$(uid)
      )
        && 'usernameLower' in getAfter(
          /databases/$(database)/documents/viaggiatori/$(uid)
        ).data
        && getAfter(
          /databases/$(database)/documents/viaggiatori/$(uid)
        ).data.usernameLower == username;
    }

    function isTripMember(tripData) {
      return verifiedUser()
        && (
          tripData.get('ownerUid', '') == request.auth.uid
          || tripData.get('memberUids', []).hasAny([
            request.auth.uid
          ])
        );
    }

    // =========================================================
    // USER PROFILE
    // =========================================================
    match /viaggiatori/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'username',
          'usernameLower',
          'email',
          'createdAt',
          'firstName',
          'lastName',
          'bio',
          'updatedAt',
          'photoUrl',
          'photoPath',
          'fcmToken',
          'notificationLocale',
          'fcmUpdatedAt'
        ])
        && (
          !('email' in request.resource.data)
          || request.resource.data.email == request.auth.token.email
        )
        && (
          !('usernameLower' in request.resource.data)
          || usernameBelongsToCurrentUser(
            request.resource.data.usernameLower
          )
        );

      allow update: if isSelf(uid)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'username',
            'usernameLower',
            'email',
            'firstName',
            'lastName',
            'bio',
            'updatedAt',
            'photoUrl',
            'photoPath',
            'fcmToken',
            'notificationLocale',
            'fcmUpdatedAt'
          ])
        && (
          (
            !('usernameLower' in resource.data)
            && !('usernameLower' in request.resource.data)
          )
          || (
            'usernameLower' in request.resource.data
            && (
              (
                'usernameLower' in resource.data
                && request.resource.data.usernameLower
                  == resource.data.usernameLower
              )
              || (
                usernameBelongsToCurrentUser(
                  request.resource.data.usernameLower
                )
                && (
                  !('usernameLower' in resource.data)
                  || !existsAfter(
                    /databases/$(database)/documents/usernames/$(resource.data.usernameLower)
                  )
                )
              )
            )
          )
        );

      allow delete: if isSelf(uid);
    }

    // =========================================================
    // USERNAME UNIQUE INDEX
    // =========================================================
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && profileUsesUsernameAfter(
          request.auth.uid,
          username
        );

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !profileUsesUsernameAfter(
          request.auth.uid,
          username
        );
    }

    // =========================================================
    // TRIPS
    // =========================================================
    match /trips/{tripId} {
      allow get: if isTripMember(resource.data);

      allow list: if verifiedUser()
        && resource.data.ownerUid == request.auth.uid;

      allow list: if verifiedUser()
        && resource.data.memberUids.hasAny([
          request.auth.uid
        ]);

      allow create: if verifiedUser()
        && request.resource.data.keys().hasAll([
          'name',
          'destination',
          'destinationData',
          'startDate',
          'endDate',
          'currency',
          'ownerUid',
          'memberUids',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'destination',
          'destinationData',
          'startDate',
          'endDate',
          'currency',
          'cloudArchive',
          'ownerUid',
          'memberUids',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.status == 'active'
        && getAfter(
          /databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)
        ).data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)
        ).data.role == 'admin';

      allow update: if verifiedUser()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'destination',
            'destinationData',
            'startDate',
            'endDate',
            'currency',
            'description',
            'coverUrl',
            'coverPath',
            'updatedAt'
          ]);

      allow delete: if false;

      // =========================================================
      // BUCKET LIST - ACTIVITY, VOTES, DELETION REQUESTS
      // =========================================================

      function bucketTrip() {
        return get(
          /databases/$(database)/documents/trips/$(tripId)
        ).data;
      }

      function bucketMember() {
        return isTripMember(bucketTrip());
      }

      function bucketOwner() {
        return verifiedUser()
          && bucketTrip().get('ownerUid', '') == request.auth.uid;
      }

      function validBucketDate(value) {
        return value is string
          && value.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$'
          );
      }

      function validBucketLink(value) {
        return value is string
          && value.size() <= 2048
          && value.matches('^https?://[^ ]+$');
      }

      function validBucketLinks(links) {
        return links is list
          && links.size() <= 20
          && (links.size() <= 0 || validBucketLink(links[0]))
          && (links.size() <= 1 || validBucketLink(links[1]))
          && (links.size() <= 2 || validBucketLink(links[2]))
          && (links.size() <= 3 || validBucketLink(links[3]))
          && (links.size() <= 4 || validBucketLink(links[4]))
          && (links.size() <= 5 || validBucketLink(links[5]))
          && (links.size() <= 6 || validBucketLink(links[6]))
          && (links.size() <= 7 || validBucketLink(links[7]))
          && (links.size() <= 8 || validBucketLink(links[8]))
          && (links.size() <= 9 || validBucketLink(links[9]))
          && (links.size() <= 10 || validBucketLink(links[10]))
          && (links.size() <= 11 || validBucketLink(links[11]))
          && (links.size() <= 12 || validBucketLink(links[12]))
          && (links.size() <= 13 || validBucketLink(links[13]))
          && (links.size() <= 14 || validBucketLink(links[14]))
          && (links.size() <= 15 || validBucketLink(links[15]))
          && (links.size() <= 16 || validBucketLink(links[16]))
          && (links.size() <= 17 || validBucketLink(links[17]))
          && (links.size() <= 18 || validBucketLink(links[18]))
          && (links.size() <= 19 || validBucketLink(links[19]));
      }

      function validBucketActivity(data) {
        return data.keys().hasAll([
          'tripId', 'name', 'city', 'country', 'type',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
          && data.keys().hasOnly([
            'tripId', 'name', 'city', 'country', 'type',
            'createdByUid', 'createdAt', 'updatedAt',
            'durationMinutes', 'notes', 'usefulLinks',
            'googlePlaceId', 'address', 'latitude', 'longitude'
          ])
          && data.tripId == tripId
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 200
          && data.city is string
          && data.city.size() <= 150
          && data.country is string
          && data.country.size() <= 150
          && data.type in [
            'attraction', 'area', 'city',
            'experience', 'event', 'other'
          ]
          && data.createdByUid is string
          && data.createdByUid.size() > 0
          && validBucketDate(data.createdAt)
          && validBucketDate(data.updatedAt)
          && data.get('notes', '') is string
          && data.get('notes', '').size() <= 10000
          && validBucketLinks(data.get('usefulLinks', []))
          && (
            data.get('durationMinutes', null) == null
            || (
              data.durationMinutes is int
              && data.durationMinutes > 0
              && data.durationMinutes <= 10080
            )
          )
          && (
            data.get('googlePlaceId', null) == null
            || data.googlePlaceId is string
          )
          && (
            data.get('address', null) == null
            || data.address is string
          )
          && (
            data.get('latitude', null) == null
            || (
              data.latitude is number
              && data.latitude >= -90
              && data.latitude <= 90
            )
          )
          && (
            data.get('longitude', null) == null
            || (
              data.longitude is number
              && data.longitude >= -180
              && data.longitude <= 180
            )
          );
      }

      match /bucketList/{activityId} {
        allow get, list: if bucketMember();

        allow create: if bucketMember()
          && validBucketActivity(request.resource.data)
          && request.resource.data.createdByUid == request.auth.uid;

        allow update: if bucketMember()
          && validBucketActivity(request.resource.data)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'name', 'city', 'country', 'type',
              'durationMinutes', 'notes', 'usefulLinks',
              'googlePlaceId', 'address', 'latitude',
              'longitude', 'updatedAt'
            ])
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.createdByUid
            == resource.data.createdByUid
          && request.resource.data.createdAt
            == resource.data.createdAt;

        // Physical deletion is reserved for a separate server flow.
        allow delete: if false;

        match /votes/{voteUid} {
          allow get, list: if bucketMember();

          allow create, update: if bucketMember()
            && voteUid == request.auth.uid
            && exists(
              /databases/$(database)/documents/trips/$(tripId)/bucketList/$(activityId)
            )
            && request.resource.data.keys().hasOnly([
              'priority', 'updatedAt'
            ])
            && request.resource.data.keys().hasAll([
              'priority', 'updatedAt'
            ])
            && request.resource.data.priority in [
              'SS', 'S', 'A', 'B'
            ]
            && request.resource.data.updatedAt == request.time;

          allow delete: if false;
        }

        match /deletionRequests/{requestUid} {
          allow get, list: if bucketMember();

          allow create: if bucketMember()
            && requestUid == request.auth.uid
            && requestUid != bucketTrip().ownerUid
            && exists(
              /databases/$(database)/documents/trips/$(tripId)/bucketList/$(activityId)
            )
            && request.resource.data.keys().hasOnly([
              'activityId', 'requestedByUid', 'reason',
              'status', 'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'activityId', 'requestedByUid', 'reason',
              'status', 'createdAt'
            ])
            && request.resource.data.activityId == activityId
            && request.resource.data.requestedByUid == requestUid
            && request.resource.data.reason is string
            && request.resource.data.reason.size() <= 500
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time;

          allow update: if bucketOwner()
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'status', 'reviewedByUid', 'reviewedAt'
              ])
            && request.resource.data.keys().hasAll([
              'status', 'reviewedByUid', 'reviewedAt'
            ])
            && request.resource.data.status in [
              'approved', 'rejected'
            ]
            && request.resource.data.reviewedByUid
              == request.auth.uid
            && request.resource.data.reviewedAt == request.time;

          allow delete: if false;
        }
      }

      match /members/{memberUid} {
        allow read: if false;

        allow create: if verifiedUser()
          && memberUid == request.auth.uid
          && !exists(
            /databases/$(database)/documents/trips/$(tripId)
          )
          && getAfter(
            /databases/$(database)/documents/trips/$(tripId)
          ).data.ownerUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/trips/$(tripId)
          ).data.memberUids == [request.auth.uid]
          && request.resource.data.keys().hasOnly([
            'uid',
            'role',
            'joinedAt',
            'travellerProfileCompleted'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'admin'
          && request.resource.data.travellerProfileCompleted == true;

        allow update, delete: if false;
      }
    }

    // =========================================================
    // INVITATIONS
    // =========================================================
    match /tripInvites/{tripId} {
      allow read, write: if false;
    }

    // =========================================================
    // FIRST ROOT IDENTITY - CREATE ONLY
    // Never stores plaintext private keys.
    // Client bootstrap requires a recently authenticated account.
    // =========================================================
    match /e2eeRoots/{uid} {
      allow get: if verifiedUser()
        && request.auth.uid == uid;

      allow list: if false;

      allow create: if verifiedUser()
        && request.auth.uid == uid
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000
             >= request.time.toMillis() - 300000
        && request.resource.data.keys().hasOnly([
          'version',
          'userUid',
          'deviceId',
          'createdAtMs',
          'x25519PublicKey',
          'ed25519PublicKey',
          'signature',
          'fingerprint',
          'recovery'
        ])
        && request.resource.data.keys().hasAll([
          'version',
          'userUid',
          'deviceId',
          'createdAtMs',
          'x25519PublicKey',
          'ed25519PublicKey',
          'signature',
          'fingerprint',
          'recovery'
        ])
        && request.resource.data.version == 1
        && request.resource.data.userUid == uid
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() == 43
        && request.resource.data.createdAtMs is int
        && request.resource.data.createdAtMs > 0
        && request.resource.data.x25519PublicKey is string
        && request.resource.data.x25519PublicKey.size() == 44
        && request.resource.data.ed25519PublicKey is string
        && request.resource.data.ed25519PublicKey.size() == 44
        && request.resource.data.signature is string
        && request.resource.data.signature.size() == 88
        && request.resource.data.fingerprint is string
        && request.resource.data.fingerprint.size() == 43
        && request.resource.data.recovery is map
        && request.resource.data.recovery.keys().hasOnly([
          'version', 'salt', 'nonce', 'ciphertext', 'mac'
        ])
        && request.resource.data.recovery.keys().hasAll([
          'version', 'salt', 'nonce', 'ciphertext', 'mac'
        ])
        && request.resource.data.recovery.version == 1
        && request.resource.data.recovery.salt is string
        && request.resource.data.recovery.salt.size() == 44
        && request.resource.data.recovery.nonce is string
        && request.resource.data.recovery.nonce.size() == 16
        && request.resource.data.recovery.ciphertext is string
        && request.resource.data.recovery.ciphertext.size() == 88
        && request.resource.data.recovery.mac is string
        && request.resource.data.recovery.mac.size() == 24;

      allow update, delete: if false;
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}